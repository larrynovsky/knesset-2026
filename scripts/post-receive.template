#!/bin/sh
# knesset post-receive — Studio, /Users/larry/knesset.git/hooks/post-receive
#
# ЭТОТ ФАЙЛ — single source of truth. Живая копия ставится вручную:
#   scp scripts/post-receive.template larry@studio:/tmp/knesset_pr
#   ssh larry@studio 'cp /tmp/knesset_pr /Users/larry/knesset.git/hooks/post-receive && chmod +x $_'
#
# ⚠️ post-receive НЕ МОЖЕТ отклонить push — он выполняется ПОСЛЕ приёма.
# Значит проверки здесь не блокируют доставку, они блокируют ГЕНЕРАЦИЮ
# и обязаны быть громкими. Тихий отказ здесь = рабочее дерево молча отстало,
# ровно та ловушка, что описана в ~/.infrastructure.md для health-os.
# Поэтому: всё пишется и в stdout (виден как remote: у пушащего), и в лог.

WORK=/Users/larry/knesset
LOG=/Users/larry/knesset/logs/deploy.log
PY=/opt/homebrew/bin/python3.11   # в SSH PATH нет Homebrew

# КРИТИЧНО: git выставляет GIT_DIR на bare-репозиторий, и без сброса
# любая команда в рабочем дереве уйдёт не туда ("fatal: not a git repository").
unset GIT_DIR GIT_WORK_TREE GIT_QUARANTINE_PATH GIT_INDEX_FILE

mkdir -p "$(dirname "$LOG")"
say() { echo "$1"; echo "$(date '+%Y-%m-%d %H:%M:%S') $1" >> "$LOG"; }

say "--- knesset post-receive ---"
cd "$WORK" || { say "FATAL: нет $WORK"; exit 1; }

git fetch -q bare && git reset -q --hard bare/main || {
  say "FATAL: рабочее дерево НЕ обновлено — оно отстало от canonical"
  exit 1
}
say "рабочее дерево на $(git rev-parse --short HEAD)"

# §3 — порядок критериев. Проверяется и здесь: MacBook-хук обходится
# через --no-verify, canonical обойти нельзя.
if [ -f scripts/check_criteria_order.py ]; then
  if ! "$PY" scripts/check_criteria_order.py 2>&1; then
    say "СТОП: §3 нарушен. Дерево обновлено, генерация НЕ запущена."
    exit 1
  fi
fi

# Оракул нижней границы: >=120 уникальных депутатов за каденцию 16–25.
# Только сохранённые JSON в data/, без сети. Не проверяет 120 мест на дату.
# Отсутствие проверяющего или входа — блок генерации (§20, §24), не пропуск.
if [ ! -f scripts/check_knesset_120.py ]; then
  say "СТОП: оракул 120 отсутствует. Состав не проверен; генерация НЕ запущена."
  exit 1
fi
oracle_output=$("$PY" scripts/check_knesset_120.py --data-dir "$WORK/data" 2>&1)
oracle_status=$?
say "$oracle_output"
case "$oracle_status" in
  0) ;;
  1) say "СТОП: оракул 120 обнаружил недобор депутатов. Генерация НЕ запущена."
     exit 1 ;;
  2) say "СТОП: вход оракула 120 непригоден (причина выше). Состав не проверен; генерация НЕ запущена."
     exit 1 ;;
  *) say "СТОП: внутренняя ошибка оракула 120 (код $oracle_status). Состав не проверен; генерация НЕ запущена."
     exit 1 ;;
esac

# §24 — артефакты. Ловит обход guarded_fetch и ложь свода о себе.
if [ -f scripts/check_artifacts.py ]; then
  if ! "$PY" scripts/check_artifacts.py 2>&1; then
    say "СТОП: §24 нарушен. Генерация НЕ запущена."
    exit 1
  fi
fi

# §4-§12 — валидатор карточек.
if [ -f scripts/validate_cards.py ]; then
  if ! "$PY" scripts/validate_cards.py 2>&1; then
    say "СТОП: карточки не прошли валидацию. Генерация НЕ запущена."
    exit 1
  fi
else
  say "валидатор карточек НЕ ПОСТРОЕН — карточки ничем не проверены (§20)"
fi

# Генерация отчёта.
if [ -f scripts/build_report.py ]; then
  "$PY" scripts/build_report.py 2>&1 && say "отчёт пересобран"
else
  say "генератор отчёта НЕ ПОСТРОЕН — публиковать нечего (§20)"
fi

say "--- готово ---"
exit 0
