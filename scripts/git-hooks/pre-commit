#!/bin/sh
# knesset pre-commit — CLAUDE.md §19 (single writer), §9 (легаси-эндпоинт), §18 (секреты), §3 (порядок критериев)
#
# Установка на ОБЕИХ машинах:
#   cp scripts/git-hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
# Хуки не отслеживаются git — этот файл единственный источник правды, копия ставится руками.

# ---- §19: пишет только MacBook -------------------------------------------
HOST=$(hostname -s 2>/dev/null || hostname)
case "$HOST" in
  Studio*|studio*)
    echo "ОТКАЗ (CLAUDE.md §19): коммит на Studio запрещён." >&2
    echo "  Studio — canonical-исполнитель. Пишет только MacBook." >&2
    echo "  Правь на MacBook -> git push studio main." >&2
    exit 1
    ;;
esac

# ---- §9: легаси-эндпоинт голосований --------------------------------------
# Он отвечает 200 и отдаёт НОЛЬ записей для 25-го Кнессета. Молча.
#
# Ловим ВЫЗОВ, не упоминание. Первая редакция правила заблокировала коммит,
# который её вводил: собственный комментарий с названием эндпоинта попал
# под собственный grep (2026-07-27, §22 — догфудинг). Отсюда два исключения:
# строки-комментарии и сами файлы хуков, где название неизбежно называется.
if git diff --cached -U0 -- 'scripts/*' \
     ':(exclude)scripts/git-hooks/*' ':(exclude)scripts/post-receive.template' \
   | grep -v '^+[[:space:]]*#' \
   | grep -qi '^+.*Votes\.svc'; then
  echo "ОТКАЗ (CLAUDE.md §9): в scripts/ появилась ссылка на Odata/Votes.svc." >&2
  echo "  Эндпоинт обрывается 13.07.2021 и не возвращает ошибки." >&2
  echo "  Источник голосований — только OdataV4/ParliamentInfo." >&2
  exit 1
fi

# ---- §18: грубый скан секретов --------------------------------------------
# Репозиторий публичный с первого дня. Это НЕ gitleaks: ловит очевидное.
LEAK=$(git diff --cached -U0 \
  | grep -inE '^\+.*((api[_-]?key|secret[_-]?key|access[_-]?token|password)[[:space:]]*[:=][[:space:]]*.?[A-Za-z0-9/_+-]{16,}|BEGIN [A-Z ]*PRIVATE KEY)' \
  | head -5)
if [ -n "$LEAK" ]; then
  echo "ОТКАЗ (CLAUDE.md §18): похоже на секрет в индексе." >&2
  echo "$LEAK" >&2
  echo "  Секреты живут в ~/.knesset_secrets/, не в репозитории." >&2
  echo "  Ложное срабатывание -> --no-verify, но скажи Саше." >&2
  exit 1
fi

# ---- §18b: ключи вендоров ПО ФОРМЕ, а не по имени переменной ---------------
# Скан выше ловит форму `api_key = <длинная строка>`. Он НЕ поймает голый
# ключ: в JSON под ключом "key", в строке curl, в примере в комментарии,
# в traceback. Между тем 2026-07-29 в проект пришли два реальных ключа
# (решение Р4, переиспользование из mm_crm), и защита «по имени переменной»
# защищает имя переменной, а не ключ — это буквально §24: механизм, ловящий
# только объявленную форму, защищает форму.
#
# Ловим префиксы вендоров. Строки-образцы ниже коротки намеренно, чтобы
# правило не заблокировало коммит, который его вводит (§22, догфудинг —
# ровно так уже случилось со §9 27.07).
# 2026-07-31: добавлен НОВЫЙ формат ключей Google. Правило ловило только
# `AIza…`, а выданный владельцем ключ Gemini имеет форму `AQ.…` и прошёл бы
# в публичный репозиторий насквозь. Обнаружено не проверкой, а тем, что ключ
# положили и он оказался другой формы. Тот же класс, что §9 и §23: механизм
# сторожил ФОРМУ, которая устарела, и молчал об этом.
VKEY=$(git diff --cached -U0 \
  | grep -nE '^\+.*(sk-ant-[A-Za-z0-9_-]{20,}|sk-proj-[A-Za-z0-9_-]{20,}|sk-[A-Za-z0-9]{32,}|AIza[A-Za-z0-9_-]{30,}|AQ\.[A-Za-z0-9_.-]{20,})' \
  | head -5)
if [ -n "$VKEY" ]; then
  echo "ОТКАЗ (CLAUDE.md §18): в индексе строка формы ключа вендора." >&2
  echo "$VKEY" | cut -c1-60 >&2
  echo "  Ключи knesset живут в ~/.knesset_secrets/llm.env на Studio." >&2
  echo "  Если это утечка — ключ уже скомпрометирован: ротировать, не только убрать." >&2
  exit 1
fi

# ---- §16/§18c: адреса публикации и личная почта ----------------------------
# 20.10.2026 репозиторий открыт на GitHub, адрес сайта и хост выкладки вынесены
# в ~/.knesset_secrets/ (§16). Ловим ФОРМУ: хост вида N-N-N-N.sslip.io,
# `пользователь@IPv4` и личный gmail. Образцов в этом файле нет намеренно (§22).
ADDR=$(git diff --cached -U0 \
  | grep -nE '^\+.*([0-9]{1,3}-[0-9]{1,3}-[0-9]{1,3}-[0-9]{1,3}\.sslip\.io|[A-Za-z0-9_-]+@[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}|[A-Za-z0-9._%+-]+@gmail\.com)' \
  | head -5)
if [ -n "$ADDR" ]; then
  echo "ОТКАЗ (CLAUDE.md §16/§18): в индексе адрес публикации, хост или личная почта." >&2
  echo "$ADDR" | cut -c1-80 >&2
  echo "  Адреса живут в ~/.knesset_secrets/ на Studio; ssh к Studio — по имени studio." >&2
  exit 1
fi

# ---- §3: критерии раньше данных -------------------------------------------
if [ -f scripts/check_criteria_order.py ]; then
  PY=$(command -v python3 || echo /opt/homebrew/bin/python3.11)
  "$PY" scripts/check_criteria_order.py || exit 1
fi

# ---- оракул результата: в Кнессете всегда 120 мест ----------------------
# Сетевой, поэтому НЕ в pre-commit (коммит не должен зависеть от сети),
# а в post-receive на Studio. Здесь только напоминание о его существовании.

# ---- §24: артефакты, отсутствие которых само есть нарушение --------------
if [ -f scripts/check_artifacts.py ]; then
  PY=$(command -v python3 || echo /opt/homebrew/bin/python3.11)
  "$PY" scripts/check_artifacts.py || exit 1
fi

# ---- §4-§12: валидатор карточек -------------------------------------------
# Ещё не построен. НЕ пропускаем молча (§20).
if [ -f scripts/validate_cards.py ]; then
  PY=$(command -v python3 || echo /opt/homebrew/bin/python3.11)
  "$PY" scripts/validate_cards.py || exit 1
elif [ -n "$(git diff --cached --name-only -- cards/)" ]; then
  echo "ОТКАЗ: в индексе есть cards/, но scripts/validate_cards.py не построен." >&2
  echo "  Карточка без валидатора не проверена ничем (CLAUDE.md §20)." >&2
  exit 1
fi

exit 0
